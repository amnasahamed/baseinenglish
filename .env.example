# ─── Required ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# Long random string used to sign login cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# ─── OpenAI models (defaults shown) ──────────────────────────
# Speech-to-text. gpt-4o-transcribe handles Malayalam+English mixing well.
# Try whisper-1 if you find the transcript "auto-corrects" learners' grammar too much.
OPENAI_STT_MODEL=gpt-4o-transcribe
# The speaking partner / corrector. Must support JSON-schema structured outputs.
OPENAI_CHAT_MODEL=gpt-4.1-mini
# Only set this when using a reasoning model (e.g. gpt-5-mini → minimal / low).
OPENAI_REASONING_EFFORT=
# Text-to-speech for the partner's voice.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# ─── Server ──────────────────────────────────────────────────
PORT=3000
# Where the SQLite DB and TTS cache live.
DATA_DIR=./data
# Set to 1 when running behind HTTPS (Render, Railway, Fly, nginx…) so cookies are Secure.
COOKIE_SECURE=0

# ─── Messaging: login codes + proactive reminders ────────────
# console          = print to the server log (fine for a 20-learner pilot / local dev)
# twilio_whatsapp  | twilio_sms = send through Twilio
# webhook          = POST {"to","text","kind"} JSON to MESSAGE_WEBHOOK_URL — plug in Zoho CPaaS,
#                    Gupshup, MSG91, Interakt… via their HTTP API or a tiny relay.
MESSAGE_PROVIDER=console
MESSAGE_WEBHOOK_URL=
MESSAGE_WEBHOOK_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# For WhatsApp: whatsapp:+14155238886 (sandbox) or your approved sender. For SMS: +1xxxxxxxxxx
TWILIO_FROM=
# Optional: a fixed code that always works for these numbers (comma separated) – handy for pilot testers.
OTP_TEST_NUMBERS=
OTP_TEST_CODE=

# ─── Allowance / pilot ───────────────────────────────────────
# Free sessions after signing in (the first guest session is always free).
FREE_TRIAL_SESSIONS=7
# Max sessions per day for anyone (trial or paid).
DAILY_SESSION_LIMIT=5
# Where the "Get the monthly pass" button points (e.g. a WhatsApp chat link or payment page).
UPGRADE_URL=https://wa.me/910000000000?text=I%20want%20the%20monthly%20pass
UPGRADE_PRICE_TEXT=₹149 / month
# Protects GET /api/admin/stats?token=...
ADMIN_TOKEN=

# Public address of the app (used in invite links and reminder messages), e.g. https://base.example.com
PUBLIC_URL=
# Free sessions BOTH people get when an invited friend verifies their phone.
REFERRAL_BONUS_SESSIONS=3
# Send personal check-in messages daily at this hour (India time, 0–23) to learners who turned
# reminders on and haven't practised yet. Leave empty to disable (or run `npm run nudges` from cron).
NUDGE_HOUR=

# Run without an OpenAI key using canned replies (UI testing only).
MOCK_AI=0
